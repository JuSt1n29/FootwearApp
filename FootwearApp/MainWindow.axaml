<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="FootwearApp.MainWindow"
        Title="Footwear Catalog - Головне меню" Width="420" Height="580">
    <StackPanel Spacing="6" Margin="25" VerticalAlignment="Center">
        <TextBlock Text="Керування довідниками" FontWeight="Bold" FontSize="16" HorizontalAlignment="Center" Margin="0,0,0,15"/>
        
        <Button Content="Country (Країни)" Click="OpenCountryWin" HorizontalAlignment="Stretch"/>
        <Button Content="Category (Категорії)" Click="OpenCategoryWin" HorizontalAlignment="Stretch"/>
        <Button Content="Material (Матеріали)" Click="OpenMaterialWin" HorizontalAlignment="Stretch"/>
        <Button Content="ShoeType (Типи взуття)" Click="OpenShoeTypeWin" HorizontalAlignment="Stretch"/>
        <Button Content="Sole (Підошви)" Click="OpenSoleWin" HorizontalAlignment="Stretch"/>
        <Button Content="Style (Стилі)" Click="OpenStyleWin" HorizontalAlignment="Stretch"/>
        <Button Content="Audience (Аудиторія)" Click="OpenAudienceWin" HorizontalAlignment="Stretch"/>
        <Button Content="Brand (Бренди)" Click="OpenBrandWin" HorizontalAlignment="Stretch"/>
        <Button Content="FootwearCatalog (Каталог взуття)" Click="OpenCatalogWin" HorizontalAlignment="Stretch" Background="LightBlue"/>
    </StackPanel>
</Window>